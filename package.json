{
  "name": "kguide",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build:config": "vite build --config vite.config.js --mode config",
    "build:desktop": "vite build --config vite.config.js --mode desktop",
    "build:mobile": "vite build --config vite.config.js --mode mobile",
    "copy:assets": "cp manifest.json plugin/manifest.json && cp node_modules/driver.js/dist/driver.css plugin/css/driver.css",
    "build": "npm run build:config && npm run build:desktop && npm run build:mobile && npm run copy:assets",
    "keygen": "cli-kintone plugin keygen --output private.ppk",
    "pack": "cli-kintone plugin pack --input plugin/manifest.json --output dist/plugin.zip --private-key private.ppk",
    "upload": "node --env-file-if-exists=.env node_modules/.bin/cli-kintone plugin upload --input dist/plugin.zip"
  },
  "dependencies": {
    "driver.js": "^1.8.0",
    "i18next": "^26.4.2",
    "kintone-ui-component": "^1.26.0"
  },
  "devDependencies": {
    "@kintone/cli": "^1.21.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.0",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "core-js@3.50.0": true
  }
}
